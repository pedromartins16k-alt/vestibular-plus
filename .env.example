# ============================================================
# VESTIBULAR+ — VARIÁVEIS DE AMBIENTE
# ============================================================

# Frontend (Vite)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLIC_AQUI

# Backend Serverless Functions (Vercel)
# O Supabase no servidor pode usar SUPABASE_URL ou reaproveitar VITE_SUPABASE_URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLIC_AQUI
# Opcional para validações administrativas:
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_AQUI

# Provedores de IA para Correção de Redação (Configure nas variáveis da Vercel)
# Prioridade 1: Groq (Recomendado / Alta velocidade)
GROQ_API_KEY=SUA_CHAVE_GROQ_AQUI
GROQ_MODEL=llama-3.3-70b-versatile

# Prioridade 2: Google Gemini (Alternativa)
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI
GEMINI_MODEL=gemini-1.5-flash

# Prioridade 3: OpenAI (Alternativa)
OPENAI_API_KEY=SUA_CHAVE_OPENAI_AQUI
OPENAI_MODEL=gpt-4o-mini
